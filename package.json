{
  "name": "fluxget",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "backend": "uv run uvicorn backend.app.main:app --reload --host 127.0.0.1 --port 8000",
    "check": "tsc -b --pretty false",
    "lint": "pnpm lint:frontend && pnpm lint:backend",
    "lint:frontend": "eslint . --max-warnings 0",
    "lint:backend": "uv run ruff check .",
    "format": "pnpm format:frontend && pnpm format:backend",
    "format:frontend": "prettier . --write",
    "format:backend": "uv run ruff format .",
    "format:check": "pnpm format:frontend:check && pnpm format:backend:check",
    "format:frontend:check": "prettier . --check",
    "format:backend:check": "uv run ruff format --check .",
    "test:backend": "uv run python -m unittest discover -s backend/tests -v"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.18.2",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "7.3.6"
  }
}
